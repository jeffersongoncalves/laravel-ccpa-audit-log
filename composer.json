{
    "name": "jeffersongoncalves/laravel-ccpa-audit-log",
    "description": "CCPA/CPRA audit log for Laravel: tamper-evident, hash-chained record of who viewed, changed, exported or deleted personal information.",
    "keywords": [
        "laravel",
        "ccpa",
        "cpra",
        "audit-log",
        "hash-chain",
        "personal-information",
        "privacy"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-ccpa-audit-log",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Simão Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\CcpaAuditLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\CcpaAuditLog\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\CcpaAuditLog\\CcpaAuditLogServiceProvider"
            ],
            "aliases": {
                "CcpaAuditLog": "JeffersonGoncalves\\CcpaAuditLog\\Facades\\CcpaAuditLog"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
